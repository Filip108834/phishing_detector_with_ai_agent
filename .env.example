# ============================================================
# Konfiguracja środowiska laboratoryjnego
# Skopiuj do .env i wypełnij własnymi wartościami
# NIGDY nie commituj pliku .env do repozytorium
# ============================================================

# --- Baza danych ---
# Uwaga: dialekt postgresql+psycopg (psycopg3), NIE psycopg2
DATABASE_URL=postgresql+psycopg://thesis:thesis@db:5432/phishing_lab

# --- Gophish ---
# API key z panelu Gophish: Admin -> Account Settings -> API Key
# Dla lokalnych skryptów (poza Dockerem) użyj http://localhost:3333
GOPHISH_API_URL=http://localhost:3333
GOPHISH_API_KEY=your_gophish_api_key_here

# --- MailHog ---
# Dla lokalnych skryptów (poza Dockerem) użyj localhost
MAILHOG_API_URL=http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Agent AI ---
# Ścieżka do wytrenowanego modelu (względem CWD aplikacji)
MODEL_PATH=models/classifier.joblib

# Próg decyzyjny klasyfikatora (0.0 - 1.0)
PHISHING_THRESHOLD=0.5

# Background poller MailHog (true/false)
MAILHOG_POLLER_ENABLED=true

# Interwał pollera w sekundach
MAILHOG_POLL_INTERVAL=15
